{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@margincook/types": ["./packages/types/src/index.ts"],
      "@margincook/types/*": ["./packages/types/src/*"],
      "@margincook/core": ["./packages/core/src/index.ts"],
      "@margincook/core/*": ["./packages/core/src/*"]
    }
  }
}
