{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex-team-service:generated-files:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generator_version", "input_sha256", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "generator_version": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "files": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/file"}}
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "mode", "classification"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.(/|$))(?!.*:)[A-Za-z0-9._/-]+$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "mode": {"enum": ["TRACKED_PROJECT", "RUNTIME_REFERENCE_ONLY"]},
        "classification": {"enum": ["UNCHANGED", "CREATE", "MERGE_REQUIRED", "CONFLICT"]}
      }
    }
  }
}
