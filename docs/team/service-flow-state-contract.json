{
  "schema_version": 1,
  "kind": "CANDIDATE_STATE_CONTRACT_NOT_RUNTIME",
  "gate_status": "NOT_VALIDATED",
  "entities": {
    "Task": {
      "owner": "service-chief",
      "states": [
        "READY",
        "ACTIVE",
        "BLOCKED",
        "STOP_REQUESTED",
        "STOPPED_WITH_PENDING",
        "STOPPED",
        "COMPLETED"
      ],
      "roll_up": "Current generation required subtask results + independent Quality + human final receipt; no unresolved blocker/pending/STOP.",
      "primary_key": [
        "task_id"
      ],
      "run_generation_role": "CURRENT_EXECUTION_METADATA_HISTORY_IN_EVENTS"
    },
    "subtask": {
      "owner": "responsible-team",
      "states": [
        "READY",
        "ACTIVE",
        "BLOCKED",
        "RESULT_SUBMITTED",
        "RESULT_VERIFIED",
        "CANCEL_PENDING",
        "CANCELLED"
      ],
      "roll_up": "Only own required assignments in current generation; never overwrite siblings.",
      "primary_key": [
        "task_id",
        "subtask_id"
      ],
      "run_generation_role": "CURRENT_EXECUTION_METADATA_HISTORY_IN_EVENTS"
    },
    "assignment": {
      "owner": "assigned-role",
      "states": [
        "READY",
        "ACKNOWLEDGED",
        "EXECUTING",
        "RESULT_SUBMITTED",
        "RESULT_VERIFIED",
        "BLOCKED",
        "CANCEL_PENDING",
        "CANCELLED"
      ],
      "transition": "Delivery ACK authorizes next hop READY or final owner EXECUTING, never automatic Task completion.",
      "primary_key": [
        "task_id",
        "assignment_id"
      ],
      "run_generation_role": "CURRENT_EXECUTION_METADATA_HISTORY_IN_EVENTS"
    },
    "delivery": {
      "owner": "source-role",
      "states": [
        "READY",
        "PREPARED",
        "SENT_UNCONFIRMED",
        "ACKNOWLEDGED",
        "RESULT_VERIFIED",
        "UNKNOWN_DELIVERY",
        "REJECTED"
      ],
      "transition": "Per-leg keyed state; queued != ACK != work completion; no blind ambiguous resend.",
      "primary_key": [
        "task_id",
        "route_id"
      ],
      "run_generation_role": "CURRENT_EXECUTION_METADATA_HISTORY_IN_EVENTS"
    },
    "effect": {
      "owner": "executing-role",
      "states": [
        "UNCLAIMED",
        "CLAIMED",
        "EXECUTED",
        "RESULT_RECORDED",
        "UNKNOWN_EFFECT"
      ],
      "transition": "Claim authority/epoch/run CAS under root lock shared with STOP; old actual effects reconcile before new claims.",
      "primary_key": [
        "task_id",
        "effect_key"
      ],
      "run_generation_role": "CLAIM_METADATA_NOT_IDENTITY",
      "unique_key": [
        "task_id",
        "effect_key"
      ]
    },
    "blocker": {
      "owner": "reporting-role",
      "states": [
        "OPEN",
        "REPORT_PENDING",
        "REPORT_SENT_UNCONFIRMED",
        "REPORT_ACKED",
        "WAITING_HUMAN_DECISION",
        "RESOLVED"
      ],
      "transition": "Per-blocker keyed state; valid exact human decision only; sibling state unchanged.",
      "primary_key": [
        "task_id",
        "blocker_id"
      ],
      "run_generation_role": "CURRENT_EXECUTION_METADATA_HISTORY_IN_EVENTS"
    }
  },
  "event_required_fields": [
    "event_id",
    "entity_type",
    "entity_id",
    "expected_entity_revision",
    "task_id",
    "run_generation",
    "kind",
    "payload",
    "authority_ref",
    "provenance_ref"
  ],
  "fence_required_fields": [
    "task_revision",
    "stop_epoch",
    "run_generation",
    "assignment_id",
    "effect_key",
    "activation_epoch",
    "lease_nonce",
    "decision_id",
    "authority_revision",
    "not_before",
    "expires_at"
  ],
  "authority_transitions": {
    "READY_PREPARED": "AUTH_EXPIRED/REVOKED -> block and cancel unconsumed actions",
    "SENT_EXECUTING": "No new send/effect; reconcile consumed effects; safety STOP/report capability only",
    "resume": "New valid human Decision and new run_generation",
    "late_receipt_valid_at_execution": "AUDIT_ONLY",
    "invalid_at_execution": "REJECTED"
  },
  "concurrency": {
    "lock_scope": "root Task",
    "linearized": [
      "STOP_CAS",
      "DAG_EXPANSION",
      "SEND_FENCE_CONSUME",
      "EFFECT_CLAIM"
    ],
    "stop_first": "Reject stale claims",
    "claim_first": "In-flight/pending; do not claim rollback",
    "old_generation_receipt": "Old delivery audit only; cannot complete current generation"
  },
  "acceptance_case": "AC-18",
  "intent_key_fields": [
    "task_id",
    "run_generation",
    "assignment_id",
    "leg_id",
    "work_spec_revision",
    "logical_source",
    "logical_target",
    "message_kind"
  ],
  "intent_reuse": {
    "same_generation_retry": "SAME_ROUTE_TOKEN",
    "endpoint_successor_same_generation": "SAME_ROUTE_TOKEN",
    "new_run_generation": "NEW_ROUTE_TOKEN",
    "effect_key": "STABLE_ACROSS_RUN_GENERATIONS"
  },
  "stop_epoch_owner": "ROOT_TASK_ONLY",
  "child_epoch": "CHILD_STOP_EPOCH_FORBIDDEN",
  "event_envelope_fields": [
    "task_id",
    "entity_id",
    "entity_type",
    "entity_revision",
    "run_generation"
  ],
  "root_control_schema": {
    "owner": "Task",
    "required": [
      "task_id",
      "task_revision",
      "command_seq",
      "stop_epoch",
      "run_generation"
    ],
    "integer_fields": {
      "task_revision": {
        "min": 0
      },
      "command_seq": {
        "min": 0
      },
      "stop_epoch": {
        "min": 0
      },
      "run_generation": {
        "min": 1
      }
    },
    "child_epoch": "FORBIDDEN"
  },
  "authority_schema": {
    "required": [
      "decision_id",
      "authority_revision",
      "issued_at",
      "not_before",
      "expires_at",
      "revoked_at",
      "allowed_actions",
      "scope",
      "human_provenance_ref"
    ],
    "revoked_at": "null or UTC timestamp",
    "time_order": "issued_at <= not_before < expires_at",
    "scope": "Intersection with Task/role/Router; never inferred from reporting permission"
  },
  "control_transitions": [
    {
      "event": "STOP",
      "from": [
        "READY",
        "ACTIVE",
        "BLOCKED"
      ],
      "to": "STOP_REQUESTED",
      "guards": [
        "ROOT_REVISION_AND_COMMAND_SEQ_CAS"
      ],
      "updates": [
        "increment command_seq",
        "increment stop_epoch",
        "invalidate unconsumed leases",
        "cancel descendants"
      ]
    },
    {
      "event": "AUTH_EXPIRED",
      "from": [
        "READY",
        "ACTIVE",
        "BLOCKED"
      ],
      "to": "BLOCKED",
      "guards": [
        "TRUSTED_TIME_AT_OR_AFTER_EXPIRES_AT"
      ],
      "updates": [
        "ban new send/effect",
        "reconcile in-flight",
        "safety capability only"
      ]
    },
    {
      "event": "AUTH_REVOKED",
      "from": [
        "READY",
        "ACTIVE",
        "BLOCKED"
      ],
      "to": "BLOCKED",
      "guards": [
        "EXACT_AUTHORITY_REVISION_REVOKED"
      ],
      "updates": [
        "ban new send/effect",
        "reconcile in-flight"
      ]
    },
    {
      "event": "RESUME",
      "from": [
        "BLOCKED",
        "STOPPED",
        "STOPPED_WITH_PENDING"
      ],
      "to": "READY",
      "guards": [
        "NEW_VALID_HUMAN_DECISION",
        "ROOT_CAS",
        "PRIOR_EFFECTS_RECONCILED"
      ],
      "updates": [
        "increment command_seq",
        "increment run_generation",
        "keep effect unique keys"
      ]
    },
    {
      "event": "REPLAY_OR_STALE_COMMAND",
      "from": [
        "*"
      ],
      "to": "REJECTED_NO_STATE_CHANGE",
      "guards": [
        "DUPLICATE_EVENT_OR_STALE_REVISION_OR_COMMAND_SEQ"
      ],
      "updates": []
    }
  ],
  "delivery_receipt_types": {
    "APP_QUEUED": {
      "state": "SENT_UNCONFIRMED",
      "close_scope": false
    },
    "TARGET_ACK": {
      "state": "ACKNOWLEDGED",
      "requires": "PROVENANCE_AND_FULL_INTENT_BINDING_VERIFIED",
      "close_scope": true
    },
    "TASK_RESULT": {
      "requires": "INDEPENDENT_RESULT_VERIFICATION",
      "ack_only": false
    }
  }
}
