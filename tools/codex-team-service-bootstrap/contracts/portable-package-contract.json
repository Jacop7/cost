      "allows": ["TASK_NORMALIZATION", "EVENT_CHAIN", "INTENT_EFFECT_CAS", "OUTBOX_REPLAY", "BLOCKER_LIFECYCLE", "LOCAL_STOP", "SIMULATION"],
      "forbids": ["PROVIDER_SEND", "STRICT_ACK", "DELIVERED", "COMPLETED"]
