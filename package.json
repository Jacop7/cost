{
  "name": "margincook-platform",
  "version": "0.2.0",
  "private": true,
  "description": "식자재 원가 계산 및 발주 관리 앱 — 데이터 플랫폼 (Expo + Supabase 모노레포)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.19.4"
  },
  "pnpm": {
    "overrides": {
      "jsdom": "^26.1.0"
    }
  },
  "scripts": {
    "mobile": "corepack pnpm --filter @margincook/mobile",
    "db": "corepack pnpm --filter @margincook/db",
    "core": "corepack pnpm --filter @margincook/core",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test",
    "verify": "node scripts/verify.mjs",
    "verify:contracts": "node scripts/verify-contracts.mjs",
    "verify:design-history": "node scripts/verify-design-history.mjs",
    "fable:check": "node scripts/fable-review.mjs --check",
    "fable:self-test": "node scripts/fable-review.mjs --self-test && node scripts/fable-review/protocol-v12.test.mjs",
    "fable:append": "node scripts/fable-review.mjs --append-turn",
    "fable:review": "node scripts/fable-review.mjs",
    "ai:plans:simulate": "node --test scripts/ai-plan-network-simulation.test.mjs",
    "ai:starter-kit:check": "node --test scripts/ai-team-starter-kit.test.mjs",
    "gate:capture": "node scripts/protected-gate-validator.mjs --capture-checks",
    "gate:closure": "node scripts/protected-gate-validator.mjs --closure-task",
    "ruleset:check": "node scripts/github-ruleset.mjs check",
    "ruleset:fix": "node scripts/github-ruleset.mjs fix",
    "lint": "corepack pnpm -r lint",
    "db:start": "corepack pnpm --filter @margincook/db start",
    "db:reset": "corepack pnpm --filter @margincook/db reset",
    "db:types": "corepack pnpm --filter @margincook/db gen:types",
    "db:test": "corepack pnpm --filter @margincook/db test",
    "db:deploy:staging:plan": "corepack pnpm --filter @margincook/db deploy:staging:plan",
    "db:deploy:staging:apply": "corepack pnpm --filter @margincook/db deploy:staging:apply",
    "db:smoke:staging:international": "corepack pnpm --filter @margincook/db smoke:staging:international",
    "db:deploy:production:plan": "corepack pnpm --filter @margincook/db deploy:production:plan",
    "db:deploy:production:apply": "corepack pnpm --filter @margincook/db deploy:production:apply",
    "prototype:audit": "node docs/prototypes/full-page-flow-prototype-render-audit.mjs docs/prototypes/0_full-page-flow-prototype-ui-applied.html docs/prototypes/full-page-flow-prototype-render-audit.json",
    "prototype:audit:setup": "corepack pnpm exec playwright install chromium",
    "three-surface:visual:capture": "node scripts/three-surface-visual-capture.mjs",
    "three-surface:visual:check": "node scripts/three-surface-visual-diff-check.mjs",
    "three-surface:visual:test": "node --test scripts/three-surface-visual-diff-check.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "prettier": "^3.3.3",
    "playwright": "1.62.1"
  }
}
