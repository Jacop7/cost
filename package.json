{
  "name": "sikjae-platform",
  "version": "0.1.0",
  "private": true,
  "description": "식자재 원가 계산 및 발주 관리 앱 — 데이터 플랫폼 (Expo + Supabase 모노레포)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.19.4"
  },
  "pnpm": {
    "overrides": {
      "jsdom": "^26.1.0"
    }
  },
  "scripts": {
    "mobile": "corepack pnpm --filter @sikjae/mobile",
    "db": "corepack pnpm --filter @sikjae/db",
    "core": "corepack pnpm --filter @sikjae/core",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test",
    "verify": "node -e \"process.exit(1)\"",
    "fable:check": "node scripts/fable-review.mjs --check",
    "fable:self-test": "node scripts/fable-review.mjs --self-test && node scripts/fable-review/protocol-v12.test.mjs",
    "fable:append": "node scripts/fable-review.mjs --append-turn",
    "fable:review": "node scripts/fable-review.mjs",
    "gate:capture": "node scripts/protected-gate-validator.mjs --capture-checks",
    "gate:closure": "node scripts/protected-gate-validator.mjs --closure-task",
    "ruleset:check": "node scripts/github-ruleset.mjs check",
    "ruleset:fix": "node scripts/github-ruleset.mjs fix",
    "lint": "corepack pnpm -r lint",
    "db:start": "corepack pnpm --filter @sikjae/db start",
    "db:reset": "corepack pnpm --filter @sikjae/db reset",
    "db:types": "corepack pnpm --filter @sikjae/db gen:types",
    "db:test": "corepack pnpm --filter @sikjae/db test"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  }
}
