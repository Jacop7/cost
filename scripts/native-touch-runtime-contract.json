{
  "schemaVersion": 1,
  "platform": "android",
  "platforms": [
    "android",
    "ios"
  ],
  "closedPlatforms": [
    "android",
    "ios"
  ],
  "requireScaledLayoutWitness": [
    "ios"
  ],
  "scaledLayoutWitness": {
    "minimumDimensionChangedRatio": 0.3
  },
  "fontScales": [
    1,
    2
  ],
  "fontScalePolicies": {
    "android": {
      "1": {
        "mode": "exact",
        "value": 1
      },
      "2": {
        "mode": "exact",
        "value": 2
      }
    },
    "ios": {
      "1": {
        "mode": "exact",
        "value": 1
      },
      "2": {
        "mode": "minimum",
        "value": 2
      }
    }
  },
  "evidenceMatrix": [
    {
      "platform": "android",
      "evidenceScale": 1,
      "file": "native-touch-android-1x.json"
    },
    {
      "platform": "android",
      "evidenceScale": 2,
      "file": "native-touch-android-2x.json"
    },
    {
      "platform": "ios",
      "evidenceScale": 1,
      "file": "native-touch-ios-1x.json"
    },
    {
      "platform": "ios",
      "evidenceScale": 2,
      "file": "native-touch-ios-2x.json"
    }
  ],
  "minimumTarget": 44,
  "expectedSourceLineage": 30,
  "tolerance": "physical: effective_dp*density >= 44*density - 0.5 - 0.001px; overlap <= 0.5 + 0.001px",
  "measurement": {
    "relativeFrame": "nativeFabricUIManager.measure — onLayout과 같은 부모 상대 좌표",
    "windowFrame": "nativeFabricUIManager.measureInWindow",
    "effectiveTouch": "hitSlop 확장 뒤 직접 host parent와 실제 clipping ancestor(overflow hidden/scroll·scroll viewport·화면 root) frame의 교집합. Android와 iOS 모두 직접 host parent를 터치 경계로 삼는 것을 양 플랫폼 실제 3점 탭으로 확인했다. measureInWindow 좌표계가 다른 RNSScreen*/RCTModalHostView 플랫폼 wrapper는 wrapper 자체를 경계로 쓰지 않고 그 안의 실제 View/scroll/root를 쓴다.",
    "scope": "각 시나리오의 activeOwnerPattern에 속한 accessibilityRole=button Pressable 전수. 잔존 탭의 다른 owner는 제외 목록에 보존하고, 반 물리 픽셀 이내 반올림은 가시로 본다. 실제 overflow hidden/scroll·스크롤 viewport·화면 root만 시각 clipping 경계이며, 일반 View의 기본 overflow visible과 좌표계가 다른 RNSScreen*/RCTModalHostView 플랫폼 wrapper는 frame 밖이라는 이유만으로 clipping이라 보지 않는다. 스크롤 viewport·화면 root에 잘린 행만 판단 제외하고 비스크롤 clipping 경계에 잘린 행은 판단한다.",
    "overlap": "같은 native parent의 유효 터치 사각형 교차"
  },
