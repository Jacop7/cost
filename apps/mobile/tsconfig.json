{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-native",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@costkeep/db": [
        "../../packages/db/src/database.types.ts"
      ],
      "@costkeep/types": [
        "../../packages/types/src/index.ts"
      ],
      "@costkeep/core": [
        "../../packages/core/src/index.ts"
      ]
    },
    "composite": false
  },
  "include": [
    "app",
    "src",
    "tests",
    "*.ts",
    "*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
