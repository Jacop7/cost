# Supabase 연결 (로컬: supabase start 출력값 사용)
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# 소셜 로그인: Google Cloud의 공개 OAuth 클라이언트 식별자만 입력합니다.
# iOS는 세 값이 모두 있어야 네이티브 설정과 버튼이 활성화됩니다.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
# Apple 제공자·서버 토큰 철회·실기기 탈퇴 검증을 모두 마친 빌드에서만 true.
EXPO_PUBLIC_APPLE_ACCOUNT_DELETION_READY=false
# 개발 빌드에서 로그인 화면을 시험할 때 false. 기본값은 시드 자동 로그인.
EXPO_PUBLIC_DEV_AUTO_LOGIN=true
