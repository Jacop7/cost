# Fable audit records are byte-addressed and may preserve archived source whitespace.
# Git must neither rewrite their checkout bytes nor report the preserved bytes as new whitespace errors.
.gitattributes text eol=lf
docs/ai-review/tasks/** -text -whitespace
# 이 작업의 자문 JSON/Markdown은 byte-normative 생성 산출물이므로 일반 archive 예외보다 우선한다.
docs/ai-review/tasks/PROTOTYPE-EXPO-THREE-SURFACE-001/advisory-ledger.json text eol=lf
docs/ai-review/tasks/PROTOTYPE-EXPO-THREE-SURFACE-001/advisory-ledger.md text eol=lf

# SQL migration의 함수 본문 조각 교체는 줄끝까지 판본 계약의 일부다.
# Windows 새 clone에서도 CRLF가 섞여 전진 migration이 잘못 멈추지 않게 한다.
*.sql text eol=lf

# Project Orchestrator의 봉인 계획과 영수증은 SHA-256으로 결속된다.
# Windows 자동 CRLF 변환이 이 검증을 무효화하지 않도록 작업본도 LF로 유지한다.
.codex/mission-relay/model-plan.json text eol=lf
.codex/mission-relay/model-plan.json.sha256 text eol=lf
.codex/mission-relay/candidates/*.json text eol=lf
.codex/mission-relay/candidates/*.sha256 text eol=lf

# 3표면 레지스트리는 재생성 bytes 자체가 계약이다.
apps/mobile/src/dev/surfaceRegistry.declarations.json text eol=lf
apps/mobile/src/dev/surfaceRegistry.generated.json text eol=lf
docs/prototypes/three-surface-baseline.json text eol=lf
docs/prototypes/three-surface-approved-visual-changes.json text eol=lf
docs/prototypes/three-surface-native-evidence.json text eol=lf
docs/prototypes/three-surface-approvers.json text eol=lf
docs/prototypes/three-surface-visual-baseline/** -text

# Team service review/checkpoint artifacts are hashed as raw bytes.
docs/ai-review/evidence/TEAM-SERVICE-* -text -whitespace
docs/ai-review/evidence/TEAM-ROUTING-SERVICE-RECOVERY-001.md -text -whitespace
docs/ai-review/evidence/AI-CHAT-ROUTING-EXECUTION-DRAFT-001.md -text -whitespace
docs/팀서비스-자동흐름-구현계획.md -text
scripts/team-service-*.mjs -text
scripts/team-routing-contract-audit*.mjs -text
scripts/docs-graph-check*.mjs -text whitespace=trailing-space,space-before-tab,cr-at-eol
docs/team/chats/*.md -text whitespace=trailing-space,space-before-tab,cr-at-eol
docs/team/service-flow-acceptance.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
docs/team/service-flow-state-contract.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
docs/team/host-scope-*.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
docs/team/host-requirements-contract.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
docs/team/HOST-REQUIREMENTS.md -text whitespace=trailing-space,space-before-tab,cr-at-eol
docs/team/COOPERATIVE-FLOW-CONTRACT.md -text whitespace=trailing-space,space-before-tab,cr-at-eol
docs/team/cooperative-flow-contract.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
