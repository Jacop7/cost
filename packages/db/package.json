{
  "name": "@margincook/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/database.types.ts",
  "types": "./src/database.types.ts",
  "scripts": {
    "start": "supabase start",
    "stop": "supabase stop",
    "reset": "node scripts/reset-local.mjs",
    "diff": "supabase db diff",
    "deploy:staging:plan": "node scripts/deploy-guard.mjs --target staging --mode plan",
    "deploy:staging:apply": "node scripts/deploy-guard.mjs --target staging --mode apply",
    "smoke:staging:international": "node scripts/staging-international-smoke.mjs",
    "deploy:production:plan": "node scripts/deploy-guard.mjs --target production --mode plan",
    "deploy:production:apply": "node scripts/deploy-guard.mjs --target production --mode apply",
    "gen:types": "supabase gen types typescript --local > src/database.types.ts",
    "test": "node tests/run.mjs",
    "fresh-db": "bash scripts/fresh-db.sh"
  },
  "devDependencies": {
    "supabase": "2.116.0"
  }
}
